"""detect-secrets baseline for this repository.

Generated policy for the credential shapes this project actually handles:
MT5 account credentials and LLM provider API keys.

Run `python -m detect_secrets scan --baseline .secrets.baseline` to refresh the
baseline after reviewing additions.

Note: `.secrets.baseline` records file hashes and line numbers, not secret
values, so it is safe to commit. The repo also carries an independent scanner
(scripts/secret_scan.py) that self-tests against planted canaries, because a
scanner that silently stops matching is worse than no scanner at all.
"""

[dict]
name = "detect_secrets.core.filters.detect_secrets_potential_uuid"

[dict]
name = "detect_secrets.filters.heuristic.is_potential_uuid"

[dict]
name = "detect_secrets.filters.heuristic.is_likely_id_string"

[dict]
name = "detect_secrets.filters.heuristic.is_templated_secret"
path = "config_loader.py"

# Documentation and example files legitimately discuss credential shapes.
# They must still be scanned; only known-safe values are allow-listed below.
[dict]
name = "detect_secrets.filters.common.is_line_allowlisted"
path = "scripts/secret_scan.py"
comment = "scanner contains canary strings used to prove the scanner works"

[dict]
name = "detect_secrets.filters.common.is_line_allowlisted"
paths = [".*V2_Implementation_Plan\.md$"]
comment = "design doc; credential examples are placeholders only"

# Real key shapes this project must never commit.
[[rules]]
id = "openrouter-api-key"
description = "OpenRouter API key"
regex = '''sk-or-v1-[A-Za-z0-9]{16,}'''
keywords = ["sk-or-v1"]

[[rules]]
id = "openai-style-key"
description = "OpenAI-style API key"
regex = '''\bsk-[A-Za-z0-9]{32,}\b'''
keywords = ["sk"]

[[rules]]
id = "groq-api-key"
description = "Groq API key"
regex = '''\bgsk_[A-Za-z0-9]{20,}\b'''
keywords = ["gsk_"]

[[rules]]
id = "aws-access-key-id"
description = "AWS access key id"
regex = '''\b(A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}\b'''
keywords = ["AKIA", "ASIA"]

[[rules]]
id = "github-token"
description = "GitHub personal access token"
regex = '''\bgh[pousr]_[A-Za-z0-9]{30,}\b'''
keywords = ["ghp_", "gho_", "ghu_", "ghs_", "ghr_"]

[[rules]]
id = "slack-token"
description = "Slack token"
regex = '''\bxox[abprs]-[A-Za-z0-9-]{10,}\b'''
keywords = ["xoxa-", "xoxb-", "xoxp-", "xoxr-", "xoxs-"]

[[rules]]
id = "google-api-key"
description = "Google API key"
regex = '''\bAIza[0-9A-Za-z_-]{35}\b'''
keywords = ["AIza"]

[[rules]]
id = "private-key-block"
description = "Private key material"
regex = '''-----BEGIN ((EC|PGP|DSA|RSA|OPENSSH) )?PRIVATE KEY( BLOCK)?-----'''
keywords = ["PRIVATE KEY"]

[[rules]]
id = "generic-credential-assignment"
description = "Assignment of a literal to a credential-shaped name"
regex = '''(?i)(?:password|passwd|pwd|secret|api[_-]?key|apikey|token|access[_-]?key|client[_-]?secret)\b\s*[:=]\s*["']?(?P<value>[^\s"'#,}]{6,})'''
keywords = ["password", "secret", "api_key", "apikey", "token"]
# A value that is read from the environment is not a secret. detect-secrets has
# no negative lookahead across the captured group, so the allow-list below
# covers the common spellings instead.
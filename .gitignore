# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependency-based
node_modules/
pnpm-lockfile.yarn.lock
yarn.lock

# Environment variables
.env*
!.env.example

# Production builds
*.prod.*
*.production.*

# TypeScript
*.tsbuildinfo
*.tsbuildinfo

# Database
*.db
*.sqlite

# Journal archives and their SQLite sidecars. The `*.db` rule above matches
# the journals themselves but NOT these: an archive is named
# `engine.db.acct-<login>.<date>.archive`, so the extension is `.archive`, and
# a sidecar ends in `.db-shm` / `.db-wal`. Left unignored they would be staged
# -- roughly 50 MB of account history per archive set, which is exactly the
# kind of thing that must never reach a remote.
backups/
*.db-archive
*.archive-shm
*.archive-wal
*.db-shm
*.db-wal

# Logs
logs/
*.log

# Verification reports (may contain account details)
reports/
demo_verification_output.txt
gitlog*.txt

# Runtime artifacts
.pids
*.seed*

# OS generated files
.DS_Store
Thumbs.db

# Docker
.dockerignore

# Supabase
/.supabase

# Vite/React build
dist/
build/

# Coverage
coverage/

# IDE
.idea/
.vscode/

# Temporary
tmp/
temp/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.pyd
.pytest_cache/
# Engine data: transient artifacts that must never enter version history
data/news_cache.json
data/ui_prefs.json
data/ideas_watchlist.json
data/infoway_budget.json
data/learning.db
data/dexter_cache/
data/dexter_budget.json
data/market_bars/
data/learning_weights/
data/shadow_mode.on
.pytest_tmp/
.tmp/
.tmp_run/
pytest_*.txt
output.txt
*.db-shm
*.db-wal
